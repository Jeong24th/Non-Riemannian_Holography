Cell[677, 23, 2272, 45, 70, "Text",ExpressionUUID->"31e16c50-a861-4d80-ac82-0f928eea62d4"],
Cell[2952, 70, 223, 5, 70, "Input",ExpressionUUID->"f79082a5-f079-4c77-949d-2a2f78260853"],
Cell[3178, 77, 83, 3, 70, "Input",ExpressionUUID->"70c1ce76-a622-40f2-bcb7-b8d62d3cf24f"],
Cell[3264, 82, 50, 0, 70, "Section",ExpressionUUID->"a40f70c8-7af9-4a61-96f2-dcab800d9133"],
Cell[3317, 84, 461, 10, 70, "Input",ExpressionUUID->"80dff55d-f81e-4f36-a8f7-9c2a33dfcfcc"],
Cell[3781, 96, 464, 11, 70, "Input",ExpressionUUID->"2415a2cc-16c8-4556-af43-6feb1d785ed2"],
Cell[4248, 109, 118, 3, 70, "Section",ExpressionUUID->"984511e5-50df-459a-a9ff-49b4fafd1c79"],
Cell[4369, 114, 399, 9, 70, "Text",ExpressionUUID->"0a88f812-4200-4766-b724-f59820f90ceb"],
